-IDxcBlob* DxcCompiler::compile(const std::string& shaderSource, bool compilePixelShader, bool compileLibrary, bool compileSpirv)
+// Real Steel (2026-10-11): constants are read from a bound storage buffer at
+// 32-bit offsets instead of through 64-bit buffer device addresses (those
+// need shaderInt64, which the Adreno Android driver lacks). The recompiler's
+// vk::RawBufferLoad<T>(address[, alignment]) calls become the RsLoad*
+// helpers of the prelude (rs_shader_common.h).
+static std::string RewriteConstantLoads(const std::string& in)
 {
+    static const std::pair<const char*, const char*> kLoads[] = {
+        {"vk::RawBufferLoad<uint>(", "RsLoadU("},   {"vk::RawBufferLoad<uint2>(", "RsLoadU2("},
+        {"vk::RawBufferLoad<uint4>(", "RsLoadU4("}, {"vk::RawBufferLoad<int>(", "RsLoadI("},
+        {"vk::RawBufferLoad<float>(", "RsLoadF("},  {"vk::RawBufferLoad<float2>(", "RsLoadF2("},
+        {"vk::RawBufferLoad<float3>(", "RsLoadF3("}, {"vk::RawBufferLoad<float4>(", "RsLoadF4("},
+    };
+    std::string out = in;
+    for (const auto& [from, to] : kLoads)
+    {
+        const size_t fromLen = strlen(from), toLen = strlen(to);
+        for (size_t at = out.find(from); at != std::string::npos; at = out.find(from, at + toLen))
+            out.replace(at, fromLen, to);
+    }
+    if (out.find("vk::RawBufferLoad") != std::string::npos)
+        fputs("XenosRecomp: a vk::RawBufferLoad of an unhandled type is left in the shader\n", stderr);
+    return out;
+}
+
+IDxcBlob* DxcCompiler::compile(const std::string& originalSource, bool compilePixelShader, bool compileLibrary, bool compileSpirv)
+{
+    const std::string shaderSource = RewriteConstantLoads(originalSource);
     DxcBuffer source{};
     source.Ptr = shaderSource.c_str();
     source.Size = shaderSource.size();
