+#include <rex/main_android.h>
+
+// SDL's Java activity loads the app library and calls SDL_main through JNI
+// (looked up by name, so it must be exported). Guest memory, threads and
+// filesystem need their Android entry points loaded before anything runs.
+extern "C" __attribute__((visibility("default"))) int SDL_main(int argc, char* argv[]) {
+  rex::InitializeAndroid();
+  const int result = RunWindowedApp(argc, argv);
+  rex::ShutdownAndroid();
+  return result;
+}
