+++ b/src/core/main_android.cpp
@@ -0,0 +1,63 @@
+/**
+ * @file        rex/core/main_android.cpp
+ * @brief       Android process set-up for the runtime
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <android/api-level.h>
+
+#include <rex/filesystem.h>
+#include <rex/main_android.h>
+#include <rex/memory/utils.h>
+#include <rex/thread.h>
+
+namespace rex {
+
+int32_t GetAndroidApiLevel() {
+  static const int32_t level = android_get_device_api_level();
+  return level;
+}
+
+namespace {
+bool g_android_initialized = false;
+}
+
+void InitializeAndroid() {
+  if (g_android_initialized) return;
+  g_android_initialized = true;
+  memory::AndroidInitialize();
+  thread::AndroidInitialize();
+  filesystem::AndroidInitialize();
+}
+
+void ShutdownAndroid() {
+  if (!g_android_initialized) return;
+  g_android_initialized = false;
+  filesystem::AndroidShutdown();
+  thread::AndroidShutdown();
+  memory::AndroidShutdown();
+}
+
+}  // namespace rex
+
+namespace rex::filesystem {
+// Nothing to load yet; paths come from the application (cvars).
+void AndroidInitialize() {}
+void AndroidShutdown() {}
+
+// content:// URIs (files picked through the Storage Access Framework) would
+// need a JNI call to ContentResolver.openFileDescriptor; game data is read
+// from ordinary paths, so this is not supported.
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  (void)uri;
+  (void)mode;
+  return -1;
+}
+}  // namespace rex::filesystem
+
+#endif  // REX_PLATFORM_ANDROID
